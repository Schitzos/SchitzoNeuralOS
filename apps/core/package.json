{
  "name": "@schitzo/core",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test && npm run lint",
    "validate": "npm run build && npm run test && npm run lint && npm run start:check",
    "start:check": "timeout 10s npm run dev || echo 'Startup check completed'",
    "fix": "npm run lint:fix && prettier --write \"src/**/*.ts\"",
    "pre-commit": "npm run check"
  },
  "dependencies": {
    "@nestjs/common": "11.1.21",
    "@nestjs/core": "11.1.21",
    "@nestjs/platform-express": "11.1.21",
    "@prisma/client": "6.9.0",
    "@schitzo/shared": "*",
    "@schitzo/types": "*",
    "bullmq": "5.52.2",
    "dotenv": "16.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.21",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.21",
    "prisma": "6.9.0",
    "typescript": "5.8.3",
    "vitest": "3.2.1"
  }
}
