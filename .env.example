# Schitzo NeuralOS Environment Configuration

# === Server ===
PORT=3000
NODE_ENV=development

# === Database (PostgreSQL) ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/schitzo_neural_os

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379

# === Authentication ===
AUTH_TOKEN=your-local-admin-token-here

# === Telegram (Schitzo Link) ===
TELEGRAM_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
TELEGRAM_ALLOWED_USER_IDS=your-telegram-user-id

# === 9Router ===
NINE_ROUTER_URL=http://localhost:9090
NINE_ROUTER_API_KEY=your-9router-api-key

# === Hermes ===
HERMES_URL=http://localhost:8080

# === GitHub ===
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_REPO=Schitzos/SchitzoNeuralOS

# === Timezone ===
TZ=Asia/Jakarta
